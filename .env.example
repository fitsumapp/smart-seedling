# Django Security
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL in production, defaults to SQLite if left empty or commented out)
# DATABASE_URL=postgres://user:password@localhost:5432/smart_seedling_db

# Localization & Timezone
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# CORS / CSRF (if deployed behind proxy or custom domain)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
